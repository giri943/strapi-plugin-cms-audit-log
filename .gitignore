############################
# Data exports
############################

# Exported content is real data and must never be committed. Test fixtures are the
# one exception and are re-included below.
*.csv
*.tsv
*.xlsx
!server/tests/fixtures/**/*.csv
!playground/fixtures/**/*.csv


############################
# Logs and databases
############################

.tmp
*.log
*.sql
*.sqlite
*.sqlite3
*.db


############################
# Misc.
############################

*#
ssl
.idea
nbproject
.tsbuildinfo
.eslintcache
.env


############################
# Strapi
############################

public/uploads/*
!public/uploads/.gitkeep


############################
# Build
############################

dist
build

# Local tarballs from `npm pack`, used to install the plugin into a test project
*.tgz

# Compiled JS artifacts that may land in src directories during a bad build
server/src/**/*.js
admin/src/**/*.js


